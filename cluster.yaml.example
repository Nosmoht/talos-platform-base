# Cluster bootstrap identity — ArgoCD root Application parameters.
#
# Since the OpenTofu cluster-lifecycle cutover, Talos node/class definitions
# live in the consumer's OpenTofu root that calls the tofu/modules/talos-cluster
# module — they are NO LONGER part of cluster.yaml. This file now carries ONLY
# the GitOps bootstrap identity that `make argocd-bootstrap` renders into the
# ArgoCD root Application / Project.
#
# Copy this file to cluster.yaml (gitignored at the base; committed in consumer
# repos per repo convention) and fill in your values.

cluster:
  name: my-cluster # cluster name (ArgoCD Application/Project naming)
  overlay: my-cluster # kustomize overlay name under kubernetes/overlays/
  target_revision: main # git branch/tag for the ArgoCD root application

repo:
  url: https://github.com/your-org/your-repo.git
