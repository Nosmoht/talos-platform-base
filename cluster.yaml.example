# Cluster Identity — Single Source of Truth
#
# This file is the canonical cluster identity SOT for this repo.
# It is tool-agnostic: read by make (talos/Makefile), kubectl (argocd bootstrap),
# and Claude Code skills/agents — no AI tooling required to use it.
#
# Copy this file to cluster.yaml (gitignored) and fill in your cluster values.
# One cluster.yaml per working tree. For multi-cluster: pass ENV=../other/cluster.yaml
# to talos/Makefile targets.
#
# NOTE: secrets.yaml (PKI material) is scoped to a single cluster and is NOT
# interpolated from cluster.yaml. Each cluster has its own secrets.yaml.

cluster:
  name: my-cluster
  overlay: my-cluster                      # kustomize overlay name under kubernetes/overlays/
  api_vip: 10.0.0.100                     # Kubernetes API virtual IP
  gateway_vip: 10.0.0.200                 # Gateway/LoadBalancer virtual IP
  network: 10.0.0.0/24                    # cluster network CIDR
  gateway: 10.0.0.1                       # default gateway / DNS
  ntp_server: 10.0.0.1                    # NTP server IP or hostname (required, no public default)
  target_revision: main                   # git branch/tag for ArgoCD root application (optional, default: main)

  # BGP for Cilium load-balancing (ADR-0014, Rev. 2026-05-28). Each cluster peers
  # with the edge router (e.g. UCG-Max) using a private ASN; Cilium advertises a
  # per-cluster dedicated VIP range as /32 routes which the router ECMP-balances
  # across all cluster nodes.
  #
  # Topology (ADR-0002 Rev. 2026-05-28): single VLAN per site for the node
  # subnet. Only the *node subnet* (`network` above) is L2-present in that VLAN.
  # The VIP subnet (`lb_ipam_pool`) lives in NO VLAN — it exists purely as a
  # BGP-advertised routing prefix in the router's table, with next-hops on the
  # node IPs. That is exactly what BGP-LB buys us over L2 announcements: VIPs
  # in a logical range that is nowhere ARP-present, decoupled from the node /24.
  #
  # Empty block (or removed entirely) → Cilium falls back to L2 announcements
  # on the node VLAN (see kubernetes/bootstrap/cilium/values.yaml — both modes
  # are enabled, the consumer picks via CiliumLoadBalancerIPPool annotations).
  # Note: L2 mode would force VIPs into the node /24 (ARP-bound to the VLAN).
  bgp:
    cluster_asn: 65001                    # this cluster's ASN (unique per cluster, e.g. 65001=seeder, 65002=dhq)
    peer_asn:    65000                    # router ASN (same for all clusters in this site)
    peer_ip:     10.0.0.1                 # router IP reachable from the node VLAN
    lb_ipam_pool: 10.0.1.0/28             # pure routing prefix — no L2 presence; router gets the /32s via BGP from peer_asn

kubeconfig: /tmp/my-cluster-kubeconfig     # path to kubeconfig file

nodes:
  # Control plane nodes (minimum 3 for etcd quorum)
  control_plane:
    - name: cp-01
      ip: 10.0.0.11
      nic: eth0                            # primary NIC device name
    - name: cp-02
      ip: 10.0.0.12
      nic: eth0
    - name: cp-03
      ip: 10.0.0.13
      nic: eth0

  # Standard worker nodes
  workers:
    - name: worker-01
      ip: 10.0.0.21
      nic: eth0

  # GPU worker nodes (optional — leave empty if none)
  gpu_workers: []
  # gpu_workers:
  #   - name: gpu-worker-01
  #     ip: 10.0.0.31
  #     nic: enp0s20f0u2

  # ARM/Pi nodes (optional — leave empty if none)
  pi_nodes: []
  # pi_nodes:
  #   - name: pi-01
  #     ip: 10.0.0.41

repo:
  url: https://github.com/your-org/your-repo.git

# Hardware hints — used by skills that need hardware context without live queries
hardware:
  standard_nodes: "Generic x86_64"         # short description of standard node hardware
  gpu_node: ""                             # short description of GPU node hardware
  standard_nic_driver: ""                  # e.g. "e1000e", "igc"
  gpu_nic_driver: ""                       # e.g. "r8152" for USB Realtek
