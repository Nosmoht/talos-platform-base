# CODEOWNERS — review routing for talos-platform-base
#
# Order matters: later patterns override earlier ones.
# Syntax: https://docs.github.com/repositories/managing-your-repositorys-settings-and-security/customizing-your-repository/about-code-owners

# Default: repo owner reviews everything.
*                                                @nosmoht

# Hard-constraint surfaces — require explicit owner review.
/AGENTS.md                                       @nosmoht
/CLAUDE.md                                       @nosmoht
/SECURITY.md                                     @nosmoht
/CODEOWNERS                                      @nosmoht
/MAINTAINERS.md                                  @nosmoht

# Decision records — decision-grade documents.
/knowledge/decisions/                            @nosmoht

# Machine-consumed contracts — schema/registry surfaces.
/schemas/                                        @nosmoht
/contracts/                                      @nosmoht
/platform-hardware-features.yaml                 @nosmoht

# Bundle tooling contracts. openknowledge renders these documents verbatim
# into the AGENTS.md managed block, so their bullets ARE agent instructions
# despite sitting on a docs-shaped path. Read them at AGENTS.md's bar.
#
# Marker, not a gate: `required_pull_request_reviews` is unset on main, and
# every entry in this file resolves to the same owner as the `*` catch-all
# above — so no line here blocks anything. The enforcing control is
# `task knowledge:rules-check` (Taskfile.yml), which fails unless the
# regenerated AGENTS.md rides in the same diff.
/knowledge/rules/                                @nosmoht
/knowledge/openknowledge.toml                    @nosmoht

# OCI publish surface — supply-chain critical.
/.github/workflows/oci-publish.yml               @nosmoht
/knowledge/workflows/verify-release.md           @nosmoht

# Release automation surface — supply-chain critical. These files decide what
# gets versioned, packaged, and signed; a change here can ship/sign content
# automatically, so they require explicit owner review.
/.github/workflows/release.yml                   @nosmoht
/.github/workflows/commitlint.yml                @nosmoht
/.releaserc.json                                 @nosmoht
/package.json                                    @nosmoht
/package-lock.json                               @nosmoht
/.ci-oci-tarball-include.txt                     @nosmoht
/.ci-oci-tarball-expected.txt                    @nosmoht

# Talos machine-config patches — boot-loop risk.
/talos/                                          @nosmoht
