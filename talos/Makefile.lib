# Makefile.lib — 5-axis talosctl config generation library (v0.6.0+ production path)
#
# Consumer-side usage:
#   BASE_DIR ?= ../vendor/base/talos
#   ENV      ?= ../cluster.yaml
#   include $(BASE_DIR)/Makefile.lib
#
# Status: production-safe. v0.6.0 removes the legacy talos/Makefile and makes
# this library the single supported path. Phase-3 blockers from the original
# DUAL-PATH SCOPE note are closed:
#   - CRIT-1 (Placeholder resolution): closed v0.5.2 — argv-print.sh:213 calls
#     resolve-placeholders.sh for any patch containing ${NAME} tokens.
#   - CRIT-4 (NTP patch): closed v0.5.2 — argv-print.sh:108-122 renders the
#     NTP patch from cluster.ntp_server as the first --config-patch.
# Provided targets: gen-configs, schematics, validate-schematics, argv-print,
# test-bit-identity, test-substitution.
# See talos/RELEASE-NOTES-v0.5.2.md (Phase-3 closures) and v0.5.4.md / v0.6.0
# release notes (legacy-path removal, cluster.vip rename).

BASE_DIR ?= $(shell pwd)
ENV ?= ../cluster.yaml
CLUSTER_YAML ?= $(ENV)

# ---------------------------------------------------------------------------
# Guard: ENV must exist at parse-time for per-node rule expansion.
# ---------------------------------------------------------------------------
ifeq ($(wildcard $(CLUSTER_YAML)),)
  $(error Cluster config not found: $(CLUSTER_YAML). Set ENV= or CLUSTER_YAML= to your cluster.yaml path.)
endif

# ---------------------------------------------------------------------------
# Node list (5-axis format: nodes[].name)
# ---------------------------------------------------------------------------
NODES := $(shell yq -r '.nodes[].name' $(CLUSTER_YAML) 2>/dev/null)
ifeq ($(strip $(NODES)),)
  $(error yq required and cluster.yaml .nodes[] must be non-empty. Is yq on PATH? CLUSTER_YAML=$(CLUSTER_YAML))
endif

# ---------------------------------------------------------------------------
# Cluster identity (single Kubernetes API VIP; gateway_vip is intentionally
# absent — see talos/schemas/cluster.schema.json $defs.cluster-identity)
# ---------------------------------------------------------------------------
CLUSTER_NAME := $(shell yq -r '.cluster.name' $(CLUSTER_YAML) 2>/dev/null)
OVERLAY      := $(shell yq -r '.cluster.overlay // .cluster.name' $(CLUSTER_YAML) 2>/dev/null)
OUT_BASE     := _out/$(OVERLAY)

# Per-node role + output-type + output-file mapping (parse-time evaluation
# via yq; one $(shell) per node, ~10 nodes is the upper end of homelab scale,
# Make caches the result for the parse pass).
$(foreach n,$(NODES),\
  $(eval _ROLE_$(n)    := $(shell yq -r '.nodes[] | select(.name == "$(n)") | .role' $(CLUSTER_YAML) 2>/dev/null)) \
  $(eval _OTYPE_$(n)   := $(if $(filter controlplane,$(_ROLE_$(n))),controlplane,worker)) \
  $(eval _OUTPUT_$(n)  := $(OUT_BASE)/$(_OTYPE_$(n))/$(n).yaml) \
)

# Secrets source file (SOPS-encrypted). Decrypted ephemerally per build.
SECRETS_FILE_SOURCE ?= secrets.yaml

# Default schematic cache path (per Phase 1B convention; consumer-local).
SCHEMATIC_CACHE ?= $(BASE_DIR)/../talos/.schematic-cache.yaml

.PHONY: gen-configs schematics validate-schematics argv-print clean

# ---------------------------------------------------------------------------
# gen-configs — produces one machine config per node under
# _out/<overlay>/<output-type>/<node>.yaml. Per-node rule is generated
# explicitly (no pattern-rule directory bootstrap issue from GNU Make 3.81).
# ---------------------------------------------------------------------------
gen-configs: $(foreach n,$(NODES),$(_OUTPUT_$(n)))

# ---------------------------------------------------------------------------
# schematics — Phase 1B: hash-dedup schematic cache
# ---------------------------------------------------------------------------
SCHEMATIC_CACHE ?= $(BASE_DIR)/../talos/.schematic-cache.yaml

schematics:
	@bash "$(BASE_DIR)/scripts/build-schematic-cache.sh" "$(CLUSTER_YAML)" "$(SCHEMATIC_CACHE)"

# ---------------------------------------------------------------------------
# validate-schematics — Phase 1B: cross-reference diagnostics
# ---------------------------------------------------------------------------
validate-schematics:
	@bash "$(BASE_DIR)/scripts/validate-schematics.sh" "$(CLUSTER_YAML)" "$(BASE_DIR)"

# ---------------------------------------------------------------------------
# validate-schematics-test — regression coverage for cross-reference diagnostics
# Usage: make -f Makefile.lib validate-schematics-test CLUSTER_YAML=test/fixtures/valid-minimal.yaml
# (CLUSTER_YAML must point at an existing file to satisfy the parse-time guard
#  at line 27; the target body invokes the script against its own fixture set.)
# ---------------------------------------------------------------------------
.PHONY: validate-schematics-test

validate-schematics-test:
	@set -e; \
	echo "[positive] valid-minimal.yaml expects exit 0"; \
	bash "$(BASE_DIR)/scripts/validate-schematics.sh" "$(BASE_DIR)/test/fixtures/valid-minimal.yaml" "$(BASE_DIR)"; \
	echo "[positive] valid-all-layer-c-features.yaml expects exit 0"; \
	bash "$(BASE_DIR)/scripts/validate-schematics.sh" "$(BASE_DIR)/test/fixtures/valid-all-layer-c-features.yaml" "$(BASE_DIR)"; \
	echo "[negative] invalid-feature-not-in-registry.yaml expects exit 1"; \
	if bash "$(BASE_DIR)/scripts/validate-schematics.sh" "$(BASE_DIR)/test/fixtures/invalid-feature-not-in-registry.yaml" "$(BASE_DIR)" > /dev/null 2>&1; then \
		echo "FAIL: expected exit 1 on invalid-feature fixture"; exit 1; \
	fi; \
	echo "validate-schematics-test: PASS"

# ---------------------------------------------------------------------------
# argv-print — Phase 1C: emit exact talosctl gen config argv for NODE=<name>
# ---------------------------------------------------------------------------
# Usage: make argv-print NODE=<name>
# Reads cluster.yaml via argv-print.sh; emits one argv element per line.
# SCHEMATIC_CACHE defaults to <BASE_DIR>/.schematic-cache.yaml.
# ---------------------------------------------------------------------------
NODE ?=
SCHEMATIC_CACHE ?= $(BASE_DIR)/.schematic-cache.yaml

.PHONY: argv-print test-bit-identity

argv-print:
	@if [ -z "$(NODE)" ]; then \
	    echo "Usage: make argv-print NODE=<name>" >&2; exit 1; \
	fi
	@bash "$(BASE_DIR)/scripts/argv-print.sh" "$(CLUSTER_YAML)" "$(NODE)" "$(BASE_DIR)" "$(SCHEMATIC_CACHE)"

# ---------------------------------------------------------------------------
# test-bit-identity — Phase 1C: diff argv-print output against legacy argv-dump
# ---------------------------------------------------------------------------
# Usage: make test-bit-identity
# Requires: ARGV_DUMP_DIR pointing to .work/p2-talos-oci/argv-dump/
REPO_ROOT ?= $(shell git -C "$(BASE_DIR)" rev-parse --show-toplevel 2>/dev/null || echo "$(BASE_DIR)/..")
ARGV_DUMP_DIR ?= $(REPO_ROOT)/.work/p2-talos-oci/argv-dump

test-bit-identity:
	@bash "$(BASE_DIR)/scripts/test-bit-identity.sh" 	    "$(CLUSTER_YAML)" "$(BASE_DIR)" "$(SCHEMATIC_CACHE)" "$(ARGV_DUMP_DIR)"

# ---------------------------------------------------------------------------
# test-substitution — Phase 3: assert placeholder substitution renders the
# expected golden for a known NIC_NAME binding. Validates R2 fix end-to-end:
# resolve-placeholders.sh receives a binding, substitutes ${NIC_NAME} in
# worker-kubevirt.yaml, output matches talos/test/goldens/substitution/.
# ---------------------------------------------------------------------------
SUBST_FIXTURE  ?= $(BASE_DIR)/test/fixtures/valid-substitution.yaml
SUBST_NODES    ?= $(BASE_DIR)/test/fixtures
SUBST_GOLDEN   ?= $(BASE_DIR)/test/goldens/substitution/subst-01.rendered.yaml

.PHONY: test-substitution test-substitution-update

test-substitution:
	@TMPD=$$(mktemp -d); trap 'rm -rf $$TMPD' EXIT; \
	printf 'NIC_NAME\teth0\n' > "$$TMPD/bindings.txt"; \
	bash "$(BASE_DIR)/scripts/resolve-placeholders.sh" \
	    "$(BASE_DIR)/patches/worker-kubevirt.yaml" "$$TMPD/bindings.txt" \
	    > "$$TMPD/rendered.yaml"; \
	if diff -u "$(SUBST_GOLDEN)" "$$TMPD/rendered.yaml"; then \
	    echo "OK: substitution renders match golden ($(SUBST_GOLDEN))"; \
	else \
	    echo "FAIL: substitution drift — regenerate via 'make test-substitution-update'" >&2; \
	    exit 1; \
	fi

test-substitution-update:
	@TMPD=$$(mktemp -d); trap 'rm -rf $$TMPD' EXIT; \
	printf 'NIC_NAME\teth0\n' > "$$TMPD/bindings.txt"; \
	bash "$(BASE_DIR)/scripts/resolve-placeholders.sh" \
	    "$(BASE_DIR)/patches/worker-kubevirt.yaml" "$$TMPD/bindings.txt" \
	    > "$(SUBST_GOLDEN)"; \
	echo "wrote $(SUBST_GOLDEN)"
# ---------------------------------------------------------------------------
# Per-node rules (one explicit rule per node, no pattern matching).
#
# Recipe steps:
#   1. mkdir -p output directory
#   2. SOPS-decrypt secrets.yaml into an ephemeral mktemp file with trap-cleanup
#   3. argv-print.sh emits the full talosctl argv (NTP patch + role patches +
#      per-node yaml + install-image JSON-patch + --output etc.). SECRETS_FILE
#      env-var routes argv-print to emit --with-secrets <ephemeral-path>.
#   4. Execute the emitted argv via mapfile + array expansion (no eval, no
#      word-split surprise).
#   5. Strip the auto-rendered HostnameConfig.auto field (Talos emits a
#      reverse-DNS hostname patch the consumer does not want).
#
# Patch dependency tracking is intentionally omitted: patches resolve via
# argv-print.sh emit_patch (CWD-first, BASE_DIR fallback); changes to a
# patch file require `make clean` to force regeneration. Tracking every
# possible patch as a Make pre-req would require parsing roles[].patches[]
# per node at parse time and is not worth the complexity given the small
# patch set + low edit frequency.
# ---------------------------------------------------------------------------
define _node-rule
$$(_OUTPUT_$(1)): $$(CLUSTER_YAML) nodes/$(1).yaml $$(SECRETS_FILE_SOURCE) $$(SCHEMATIC_CACHE) $$(BASE_DIR)/versions.mk
	@mkdir -p "$$(dir $$@)"
	@set -e; \
	tmp_secrets=$$$$(mktemp); \
	trap 'rm -f "$$$$tmp_secrets"' EXIT HUP INT TERM; \
	sops -d "$$(SECRETS_FILE_SOURCE)" > "$$$$tmp_secrets"; \
	mapfile -t argv < <(SECRETS_FILE="$$$$tmp_secrets" \
	    bash "$$(BASE_DIR)/scripts/argv-print.sh" \
	        "$$(CLUSTER_YAML)" "$(1)" "$$(BASE_DIR)" "$$(SCHEMATIC_CACHE)"); \
	"$$$${argv[@]}"; \
	yq eval-all 'del(select(.kind == "HostnameConfig").auto)' -i "$$@"

.PHONY: $(1)
$(1): $$(_OUTPUT_$(1))
endef

$(foreach n,$(NODES),$(eval $(call _node-rule,$(n))))

# ---------------------------------------------------------------------------
# clean — remove all generated machine configs for this overlay.
# ---------------------------------------------------------------------------
clean:
	rm -rf $(OUT_BASE)
